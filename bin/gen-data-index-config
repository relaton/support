#!/usr/bin/env ruby
# frozen_string_literal: true

# Generate the GitHub Pages index `_config.yml` for relaton-data-* repos from
# data-index/configs.yml. See data-index/README.adoc for the rollout runbook.
#
# Usage:
#   bin/gen-data-index-config                   # print every repo's config (banners)
#   bin/gen-data-index-config iso               # print one repo's config to stdout
#   bin/gen-data-index-config --out DIR         # write DIR/<repo>_config.yml for all repos
#   bin/gen-data-index-config iso --out DIR     # write DIR/iso_config.yml
#   bin/gen-data-index-config --list            # list known repos
#   bin/gen-data-index-config --config PATH ... # use an alternate configs.yml

require "optparse"

require_relative "../lib/data_index_config"

options = { config: DataIndexConfig::DEFAULT_CONFIG_PATH, out: nil, list: false }
parser = OptionParser.new do |o|
  o.banner = "Usage: bin/gen-data-index-config [repo] [options]"
  o.on("--out DIR", "Write DIR/<repo>_config.yml instead of printing") { |v| options[:out] = v }
  o.on("--config PATH", "Path to configs.yml") { |v| options[:config] = v }
  o.on("--list", "List known repos and exit") { options[:list] = true }
  o.on("-h", "--help", "Show this help") do
    puts o
    exit
  end
end
parser.parse!(ARGV)

config = DataIndexConfig.load(options[:config])

if options[:list]
  puts config.repos.map { |e| e["repo"] }
  exit
end

selected =
  if ARGV.empty?
    config.repos.map { |e| e["repo"] }
  else
    ARGV.dup
  end

known = config.repos.map { |e| e["repo"] }
unknown = selected - known
unless unknown.empty?
  warn "unknown repo(s): #{unknown.join(', ')}"
  warn "known repos: #{known.join(', ')}"
  exit 1
end

if options[:out]
  require "fileutils"
  FileUtils.mkdir_p(options[:out])
  selected.each do |repo|
    path = File.join(options[:out], "#{repo}_config.yml")
    File.write(path, config.render_repo(repo))
    warn "wrote #{path}"
  end
else
  selected.each_with_index do |repo, i|
    puts "# ===== relaton-data-#{repo}/_config.yml =====" if selected.size > 1
    puts config.render_repo(repo)
    puts if i < selected.size - 1
  end
end
