#!/usr/bin/env ruby
# frozen_string_literal: true

# Report what `cimas cleanup-orphan-files` would delete from the relaton repos,
# before anyone runs it. Read-only: this script changes no repo.
#
# Cimas deletes a file on a two-part rule (lib/cimas/orphan_files.rb):
#
#   1. the file's first 500 bytes carry `Auto-generated by Cimas`, so Cimas
#      wrote it at some point, and
#   2. the file's path is not a key of that repo's `files:` mapping, so Cimas
#      no longer regenerates it.
#
# Neither part is visible in this repo. Dropping a mapping is therefore a
# delete order for every destination repo that still holds the file — and the
# `relaton-model-*` entries lost their model mapping in 31b3fda with no note,
# while two of those repos still ran the build those files drive. This script
# is the gate that makes such a state loud. See relaton/support#65.
#
# Each row is one file:
#
#   ORPHAN   Cimas wrote it, the mapping does not cover it. A wave deletes it.
#   allowed  the same, and cimas-config/orphan-allowlist.yml records the
#            decision about it.
#   mapped   Cimas wrote it and still maps it. --all shows these.
#   hand-own the mapping covers the path but the file carries no header, so a
#            person wrote it and the next `cimas sync` overwrites it. --all
#            shows these too; it is this issue's mirror image.
#
# Exit 1 when an orphan is not in the allowlist, when a repo or branch cannot
# be read, or when an allowlist row matches nothing any more. A `review` row
# does not fail the run — a person wrote the question down — but no wave may
# run unscoped while one stands.
#
# What it does not cover: Cimas walks a whole working copy, and the GitHub API
# cannot without a clone. This lists the repo root and `.github/`, plus the
# directory of any path cimas.yml maps outside those two. A Cimas-written file
# deeper than `.github/` that this config never mapped is invisible here; the
# local `cimas cleanup-orphan-files` run without `--push-after` stays the
# second gate, and it stages exactly what it would delete.
#
# Every candidate comes from a listing, never from a blind fetch, so a failed
# read can never look like an absent file. A file too big to fetch whole is
# read to its first 500 bytes over raw.githubusercontent.com, because Cimas
# reads no further either.
#
# GitHub code search is not the tool for this. It indexes only the default
# branch, and cimas.yml targets `branch:`, which is `v2` for 20 repos.
#
# Requires `gh`, logged in, for the listings. A full sweep of 98 repos costs
# roughly 400 calls against the 5000/hour limit.
#
# Usage:
#   bin/cimas-orphan-audit                          # every repo
#   bin/cimas-orphan-audit data                     # one cimas group
#   bin/cimas-orphan-audit relaton-model-ccsds      # one repo
#   bin/cimas-orphan-audit --only-target Makefile   # one class of orphan
#   bin/cimas-orphan-audit --all                    # add the mapped rows
#   bin/cimas-orphan-audit --list                   # list repos and exit
#   bin/cimas-orphan-audit relaton-model-3gpp --only-target Makefile --show |
#     tail -n +3 | diff -u cimas-config/gh-actions/model/Makefile -
#
# `--show` prints the destination file whole, Cimas header and all, so the
# `tail -n +3` above drops those two lines to line the diff up with a template,
# which never carries them.

require "json"
require "net/http"
require "open3"
require "optparse"
require "set"
require "uri"

require_relative "../lib/cimas_config"
require_relative "../lib/orphan_allowlist"

options = {
  config: CimasConfig::DEFAULT_CONFIG_PATH,
  master: CimasConfig::DEFAULT_MASTER_PATH,
  allowlist: OrphanAllowlist::DEFAULT_PATH,
  only_targets: nil,
  max_bytes: 65_536,
  list: false,
  all: false,
  show: false,
  allow_stale: false,
}
parser = OptionParser.new do |o|
  o.banner = "Usage: bin/cimas-orphan-audit [repo-or-group...] [options]"
  o.on("--only-target PATHS", "Narrow to these destination paths (comma-separated)") do |v|
    options[:only_targets] = v.split(",").map(&:strip)
  end
  o.on("--max-bytes N", Integer,
       "Read only the header bytes of files larger than N (default 65536)") do |v|
    options[:max_bytes] = v
  end
  o.on("--config PATH", "Path to cimas.yml") { |v| options[:config] = v }
  o.on("--master PATH", "Template root the `files:` values are relative to") { |v| options[:master] = v }
  o.on("--allowlist PATH", "Path to orphan-allowlist.yml") { |v| options[:allowlist] = v }
  o.on("--all", "Also print the mapped and hand-owned rows") { options[:all] = true }
  o.on("--show", "Print one destination file and exit (needs one repo, one --only-target)") do
    options[:show] = true
  end
  o.on("--allow-stale", "Do not fail on an allowlist row that matched nothing") do
    options[:allow_stale] = true
  end
  o.on("--list", "List known repo names and exit") { options[:list] = true }
  o.on("-h", "--help", "Show this help") do
    puts o
    exit
  end
end
parser.parse!(ARGV)

config = CimasConfig.load(options[:config], master: options[:master])

if options[:list]
  puts config.names
  exit
end

begin
  selected = config.resolve(ARGV)
rescue ArgumentError => e
  warn e.message
  warn "known groups: #{config.groups.keys.join(', ')}"
  exit 2
end

if options[:show] && (selected.size != 1 || options[:only_targets]&.size != 1)
  warn "--show needs exactly one repo and one --only-target path"
  exit 2
end

# `gh api` for everything: it carries the operator's login, so a private repo
# and a public one read the same way, and the README runbook already assumes
# `gh`. Returns nil when the path is absent, which is not an error — most repos
# hold most of these paths not at all.
def gh_api(path, raw: false)
  args = ["gh", "api", path]
  args += ["-H", "Accept: application/vnd.github.raw"] if raw
  out, _err, status = Open3.capture3(*args)
  return out if status.success?

  # A rate limit answers 403 for every call after it, so every repo would read
  # as unreadable and the run would say nothing useful. Stop instead, and say
  # why. `gh api rate_limit` shows when it resets.
  if out.include?("rate limit exceeded")
    warn "GitHub rate limit exceeded. Run `gh api rate_limit --jq .resources.core` " \
         "for the reset time, then run this again."
    exit 2
  end

  nil
end

# Every file in one directory of a repo, as `path => size`. `.github` is walked
# one level deeper, because that is where every workflow lives.
#
# nil means the directory could not be read; `{}` means it holds no file. The
# two must stay apart: a repo whose root cannot be read was never audited, and
# calling that "clean" is the one answer this script must never give.
def list_dir(slug, branch, dir, recurse: false)
  path = dir.empty? ? "" : "/#{dir}"
  body = gh_api("repos/#{slug}/contents#{path}?ref=#{branch}")
  return nil unless body

  files = {}
  JSON.parse(body).each do |item|
    case item["type"]
    when "file" then files[item["path"]] = item["size"]
    when "dir"
      files.merge!(list_dir(slug, branch, item["path"], recurse: false) || {}) if recurse
    end
  end
  files
rescue JSON::ParserError
  nil
end

# The first bytes of one file, over raw.githubusercontent.com with a Range
# request, for a file too big to fetch whole. `gh api` cannot ask for a range.
# Every relaton repo is public, so this needs no token.
#
# The URL comes from CimasConfig.raw_url, which escapes the path. Interpolating
# it here raised URI::InvalidURIError on a destination path holding a space,
# and the `rescue StandardError` below then reported a readable file as
# unreadable — an exit-1 condition with no bearing on any Cimas file.
def head_bytes(slug, branch, path, bytes: CimasConfig::HEADER_READ_BYTES)
  uri = URI.parse(CimasConfig.raw_url(slug, branch, path))
  http = Net::HTTP.new(uri.host, uri.port)
  http.use_ssl = true
  http.open_timeout = 15
  http.read_timeout = 15
  res = http.request_get(uri.request_uri, "Range" => "bytes=0-#{bytes - 1}")
  # 206 is the range; 200 means the host ignored it and sent the whole file,
  # which still answers the question.
  %w[200 206].include?(res.code) ? res.body : nil
rescue StandardError
  nil
end

allowlist = OrphanAllowlist.load(options[:allowlist])
wanted = options[:only_targets]&.to_set
# Paths read as header bytes only, so the table does not claim a comparison it
# could not make.
heads = []

# Every path this config maps is a path Cimas may have written, so one the
# listings cannot see is asked for by name. A path in the repo root or under
# `.github/` is already listed, and asking again would cost one call per repo
# per path for nothing.
def covered_by_listing?(path)
  !path.include?("/") || path.start_with?(".github/")
end

historical = config.all_target_paths.reject { |path| covered_by_listing?(path) }

rows = []
unreadable = []
selected.each do |name|
  slug = config.slug(name)
  branch = config.branch(name)
  root = list_dir(slug, branch, "")
  if root.nil?
    unreadable << "#{name} (#{slug}@#{branch})"
    next
  end

  # A listing, never a blind fetch: a listing says whether a file is there, so
  # a failed read never reads as an absent file.
  listed = root.merge(list_dir(slug, branch, ".github", recurse: true) || {})
  historical.map { |path| File.dirname(path) }.uniq.each do |dir|
    extra = list_dir(slug, branch, dir)
    extra.nil? ? unreadable << "#{name} #{dir}/" : listed.merge!(extra)
  end

  candidates = listed.keys
  candidates = candidates.select { |path| wanted.include?(path) } if wanted

  blobs = {}
  candidates.each do |path|
    # Cimas reads the first 500 bytes of every file, whatever its size, so a
    # big file cannot be skipped: a published index is megabytes, and skipping
    # it would let a repo pass as clean unexamined. Over --max-bytes only the
    # header bytes are fetched, which answers the orphan question but not the
    # template comparison.
    oversize = listed[path].to_i > options[:max_bytes]
    body = if oversize
             head_bytes(slug, branch, path)
           else
             gh_api("repos/#{slug}/contents/#{path}?ref=#{branch}", raw: true)
           end

    if body
      blobs[path] = body
      heads << [name, path] if oversize
    else
      # The listing named the file, so this is a failed read, not an absent
      # file. Silence here would report a repo clean that was never looked at.
      unreadable << "#{name} #{path}"
    end
  end

  if options[:show]
    print blobs.values.first
    exit blobs.empty? ? 1 : 0
  end

  rows.concat(config.findings(name, blobs, only_targets: options[:only_targets]))
  warn "scanned #{name} (#{blobs.size} file(s))"
end

orphans = rows.select { |row| row.state == :orphan }
stale = allowlist.stale(orphans, scanned: selected, paths: options[:only_targets])

printed = rows.select do |row|
  row.state == :orphan || (options[:all] && row.state != :unmanaged) ||
    (options[:all] && row.state == :unmanaged && config.files(row.repo).key?(row.path))
end

repo_w = ([4] + printed.map { |r| r.repo.length }).max
path_w = ([4] + printed.map { |r| r.path.length }).max
header = format("%-#{repo_w}s  %-#{path_w}s  %-8s  %s", "repo", "path", "state", "note")
puts header
puts "-" * header.length

unlisted = 0
printed.each do |row|
  entry = allowlist.entry_for(row.repo, row.path)
  state =
    case row.state
    when :orphan then entry ? entry.fetch("disposition") : "ORPHAN"
    when :mapped then "mapped"
    else "hand-own"
    end
  unlisted += 1 if row.state == :orphan && entry.nil?

  # The reason is a paragraph in the allowlist; one clipped line keeps the
  # table readable, and the file is where the argument belongs.
  note = if entry
           reason = entry["reason"].to_s.tr("\n", " ").strip
           reason = "#{reason[0, 57]}..." if reason.length > 60
           "#{entry['issue']}: #{reason}"
         elsif heads.include?([row.repo, row.path])
           "header bytes only, over --max-bytes"
         elsif row.template
           "#{row.match} from #{row.template}"
         else
           "no template"
         end
  puts format("%-#{repo_w}s  %-#{path_w}s  %-8s  %s", row.repo, row.path, state, note)
end

ungrouped = config.ungrouped & selected
unless ungrouped.empty?
  warn "\nnote: no cimas group lists #{ungrouped.join(', ')}, so `cimas -g <group>` " \
       "never reaches them and `-g all` does"
end

unless stale.empty?
  warn "\n#{stale.size} allowlist row(s) matched nothing this run:"
  stale.each { |e| warn "  #{e['repo']} #{e['path']}" }
end

unless unreadable.empty?
  warn "\n#{unreadable.size} repo(s) could not be read:"
  unreadable.each { |name| warn "  #{name}" }
end

reviews = orphans.count do |row|
  allowlist.entry_for(row.repo, row.path)&.fetch("disposition", nil) == "review"
end
warn "\n#{orphans.size} orphan(s) in #{orphans.map(&:repo).uniq.size} repo(s); " \
     "#{unlisted} not in #{File.basename(options[:allowlist])}, #{reviews} still under review"

exit 1 if unlisted.positive? || !unreadable.empty? ||
          (!stale.empty? && !options[:allow_stale])
